{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remote build asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["assets"],
  "properties": {
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "source", "target", "type", "minBytes"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "target": {
            "type": "string",
            "pattern": "^public/"
          },
          "type": {
            "enum": ["svg", "asciinema-cast", "pdf", "json"]
          },
          "shape": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "enum": ["string", "number", "boolean"]
            }
          },
          "minBytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "if": {
          "properties": { "type": { "const": "json" } }
        },
        "then": {
          "required": ["shape"]
        },
        "else": {
          "not": { "required": ["shape"] }
        }
      }
    }
  }
}
