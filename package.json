{
  "name": "jackson-ferguson-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:fetch": "node scripts/fetch-remote-assets.mjs",
    "predev": "npm run assets:fetch",
    "dev": "astro dev",
    "prebuild": "npm run assets:fetch",
    "build": "astro build",
    "postbuild": "node scripts/clean-unused-assets.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/site.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:eslint && npm run lint:stylelint",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.{css,astro}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,astro}\" --fix",
    "og:render": "node scripts/render-og-card.mjs",
    "knip": "knip",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "asciinema-player": "^3.17.0",
    "astro": "^7.3.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
