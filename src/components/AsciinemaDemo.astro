---
import 'asciinema-player/dist/bundle/asciinema-player.css';
---

<div class="protostar-demo-shell">
  <div class="panel-top">
    <div class="terminal-dots" aria-hidden="true">
      <span class="dot dot-close"></span>
      <span class="dot dot-minimize"></span>
      <span class="dot dot-maximize"></span>
    </div>
    <span class="terminal-title">PROTOSTAR / INTERACTIVE INIT DEMO</span>
  </div>
  <div id="protostar-demo" class="protostar-asciinema" data-asciinema="/protostar-demo.cast">
    <noscript>
      <a href="/protostar-demo.cast">Download the Protostar terminal recording</a>
    </noscript>
  </div>
</div>

<script>
  import { create } from 'asciinema-player';

  const container = document.querySelector<HTMLElement>('#protostar-demo');

  if (container && !container.dataset.initialized) {
    container.dataset.initialized = 'true';
    const src = container.dataset.asciinema;
    if (src) {
      let symbolsReady: Promise<FontFace[]> | undefined;
      const loadSymbols = () => {
        symbolsReady ??= document.fonts.load("14px 'Symbols Nerd Font'").catch(() => []);
        return symbolsReady;
      };

      // Start the font download once the initial page has finished loading.
      if (document.readyState === 'complete') {
        void loadSymbols();
      } else {
        window.addEventListener('load', () => void loadSymbols(), { once: true });
      }

      // A projects deep link can put the demo in the first viewport.
      const loadSymbolsForProjectsLink = () => {
        if (window.location.hash === '#projects') void loadSymbols();
      };
      loadSymbolsForProjectsLink();
      window.addEventListener('hashchange', loadSymbolsForProjectsLink);

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const player = create(src, container, {
        autoPlay: false,
        preload: true,
        poster: 'npt:0:00.1',
        loop: !reduceMotion,
        speed: 1,
        terminalFontFamily: "'JetBrains Mono', 'Symbols Nerd Font', 'Fira Code', monospace",
        terminalFontSize: '14px',
        fit: 'width',
        controls: 'auto',
      });

      if (!reduceMotion) {
        const card = container.closest<HTMLElement>('.landing-reveal');
        if (!card) {
          void loadSymbols().then(() => player.play());
        } else {
          let started = false;
          let fallbackTimer: number | undefined;

          const launch = () => {
            if (started) return;
            started = true;
            if (fallbackTimer !== undefined) {
              window.clearTimeout(fallbackTimer);
            }
            card.removeEventListener('transitionend', onTransitionEnd);
            observer?.disconnect();
            void loadSymbols().then(() => player.play());
          };

          const onTransitionEnd = (e: TransitionEvent) => {
            if (e.target === card && e.propertyName === 'opacity') {
              launch();
            }
          };

          card.addEventListener('transitionend', onTransitionEnd);

          let observer: MutationObserver | null = null;
          const checkVisible = () => {
            if (card.classList.contains('is-visible')) {
              if (window.getComputedStyle(card).opacity === '1') {
                launch();
              } else if (fallbackTimer === undefined) {
                fallbackTimer = window.setTimeout(launch, 1200);
              }
            }
          };

          if (window.MutationObserver) {
            observer = new MutationObserver(checkVisible);
            observer.observe(card, { attributes: true, attributeFilter: ['class'] });
          }

          checkVisible();
        }
      }
    }
  }
</script>
