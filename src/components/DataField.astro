---
import Icon from './Icon.astro';
---

<div class="data-field" aria-hidden="true">
  <canvas id="data-canvas"></canvas>
</div>
<button class="motion-toggle" type="button" hidden>
  <span class="motion-toggle-label">Pause motion</span>
  <span class="motion-toggle-icon" data-motion-icon="pause" aria-hidden="true">
    <Icon name="pause" size={10} />
  </span>
  <span class="motion-toggle-icon" data-motion-icon="play" aria-hidden="true" hidden>
    <Icon name="play" size={10} />
  </span>
</button>
<script>
  import '../scripts/data-field';
</script>
