---
// The icons are house-style's, shared with the project sites; this inlines one.
import arrow from 'house-style/icons/arrow-up-right.svg?raw';
import arrowLeft from 'house-style/icons/arrow-left.svg?raw';
import arrowRight from 'house-style/icons/arrow-right.svg?raw';
import arrowUp from 'house-style/icons/arrow-up.svg?raw';
import close from 'house-style/icons/close.svg?raw';
import pause from 'house-style/icons/pause.svg?raw';
import play from 'house-style/icons/play.svg?raw';
import down from 'house-style/icons/arrow-down.svg?raw';
import collection from 'house-style/icons/collection.svg?raw';
import github from 'house-style/icons/github.svg?raw';
import mail from 'house-style/icons/mail.svg?raw';

const icons = {
  arrow,
  'arrow-left': arrowLeft,
  'arrow-right': arrowRight,
  'arrow-up': arrowUp,
  close,
  pause,
  play,
  down,
  collection,
  github,
  mail,
};

interface Props {
  name?: keyof typeof icons;
  size?: number;
}
const { name = 'arrow', size = 20 } = Astro.props;
const shape = icons[name].replace(/^[\s\S]*?<svg[^>]*>|<\/svg>\s*$/g, '');
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={shape}
/>
