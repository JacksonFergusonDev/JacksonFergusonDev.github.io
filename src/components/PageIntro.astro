---
interface Props {
  eyebrow: string;
  titleLine1: string;
  titleLine2?: string;
  description: string;
}

const { eyebrow, titleLine1, titleLine2, description } = Astro.props;
---

<header class="page-intro container">
  <p class="eyebrow">{eyebrow}</p>
  <h1>
    {titleLine1}
    <span class="accent">.</span>
    {titleLine2 && (
      <>
        {' '}
        <br class="desktop-break" />
        {titleLine2}
      </>
    )}
  </h1>
  <p>{description}</p>
</header>
