---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryPhoto {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  photos: GalleryPhoto[];
}

const { photos } = Astro.props;

const enlargedPhotos = await Promise.all(
  photos.map((photo) =>
    getImage({
      src: photo.src,
      width: Math.min(2400, photo.src.width),
      format: 'webp',
      quality: 85,
    }),
  ),
);
---

<div class="trip-gallery container">
  {photos.map((photo, i) => (
    <figure>
      <a
        class="gallery-image-link"
        href={enlargedPhotos[i].src}
        data-gallery-image
        data-caption={photo.caption}
        aria-label={`Enlarge photo ${i + 1}: ${photo.alt}`}
      >
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[480, 800, 1400, 2000]}
          sizes={i === 0 ? '(max-width: 1240px) 100vw, 1240px' : '(max-width: 560px) 100vw, 50vw'}
          width={i === 0 ? 1800 : 1000}
          format="webp"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      </a>
      {photo.caption && <figcaption>{photo.caption}</figcaption>}
    </figure>
  ))}
</div>
