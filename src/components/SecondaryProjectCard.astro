---
import Icon from './Icon.astro';

interface Props {
  eyebrow: string;
  title?: string;
  titleLines?: string[];
  subtitle?: string;
  repoUrl: string;
  description: string;
  tags: string[];
}

const { eyebrow, title, titleLines, subtitle, repoUrl, description, tags } = Astro.props;
---

<article class="project-card secondary">
  <p class="eyebrow">{eyebrow}</p>
  <h3>
    <a href={repoUrl} target="_blank" rel="noopener noreferrer">
      {titleLines
        ? titleLines.map((line, idx) => (
            <>
              {line}
              {idx < titleLines.length - 1 && (
                <>
                  {' '}
                  <br class="desktop-break" />
                </>
              )}
            </>
          ))
        : title}
    </a>
  </h3>
  {subtitle && <p class="project-subtitle">{subtitle}</p>}
  <p>{description}</p>
  <slot />
  <div class="tags">
    {tags.map((tag) => (
      <span>{tag}</span>
    ))}
  </div>
  <a class="text-link" href={repoUrl} target="_blank" rel="noopener noreferrer">
    View on GitHub <Icon size={16} />
  </a>
</article>
