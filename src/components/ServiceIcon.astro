---
// Font Awesome's brand marks, by way of house-style so every site draws the same ones.
import github from 'house-style/icons/brand-github.svg?raw';
import linkedin from 'house-style/icons/brand-linkedin.svg?raw';
import email from 'house-style/icons/brand-email.svg?raw';

interface Props {
  name: 'github' | 'linkedin' | 'email';
  size?: number;
}

const { name, size = 14 } = Astro.props;
const icon = { github, linkedin, email }[name];
const viewBox = icon.match(/viewBox="([^"]+)"/)?.[1];
const shape = icon.replace(/^[\s\S]*?<svg[^>]*>|<\/svg>\s*$/g, '');
---

<svg
  class="service-icon"
  width={size}
  height={size}
  viewBox={viewBox}
  fill="currentColor"
  aria-hidden="true"
  set:html={shape}
/>
