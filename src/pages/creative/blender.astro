---
import { getEntry, render } from 'astro:content';
import GalleryViewer from '../../components/GalleryViewer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import SubpageNav from '../../components/SubpageNav.astro';
import { Image, getImage } from 'astro:assets';
import { routes } from '../../lib/site';
import { getEnlargedImage } from '../../lib/images';
import { galleryGraph } from '../../lib/structured-data';

const entry = await getEntry('creative', 'blender');
if (!entry || entry.data.type !== 'blender') {
  throw new Error('Missing or invalid creative/blender content entry');
}

const { Content } = await render(entry);
const { data } = entry;

const enlargedProjects = await Promise.all(
  data.projects.map((proj) => getEnlargedImage(proj.image)),
);

const ogImage = data.projects[0]
  ? await getImage({ src: data.projects[0].image, width: 1200, format: 'jpg', quality: 85 })
  : undefined;

const structuredData = galleryGraph(Astro.site!, {
  path: routes.creative.blender.path,
  name: data.title,
  description: data.description,
  crumbs: [
    { name: routes.creative.navLabel, path: routes.creative.path },
    { name: data.title, path: routes.creative.blender.path },
  ],
  images: data.projects.map((proj, i) => ({
    url: enlargedProjects[i].src,
    caption: `${proj.title}: ${proj.alt}`,
    byAuthor: true,
  })),
});
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={ogImage?.src}
  imageAlt={data.projects[0]?.alt ?? 'Blender 3D project'}
  structuredData={structuredData}
>
  <ArticleHeader
    breadcrumbHref={routes.creative.path}
    breadcrumbLabel={routes.creative.breadcrumb}
    eyebrow={data.eyebrow}
    title={data.title}
    description={data.description}
  />

  {entry.body?.trim() && (
    <div class="container">
      <div class="prose trip-body">
        <Content />
      </div>
    </div>
  )}

  <div class="blender-grid container">
    {data.projects.map((proj, i) => (
      <article class="project-card blender-card">
        <figure class="blender-figure">
          <a
            class="gallery-image-link"
            href={enlargedProjects[i].src}
            data-gallery-image
            aria-label={`Enlarge render: ${proj.title}`}
          >
            <Image
              src={proj.image}
              alt={proj.alt}
              widths={[480, 800, 1400, 2000]}
              sizes="(max-width: 800px) 100vw, 50vw"
              width={1200}
              format="webp"
              loading={i < 2 ? 'eager' : 'lazy'}
            />
          </a>
        </figure>
        <div class="blender-details">
          <p class="eyebrow">{proj.category}</p>
          <h2>{proj.title}</h2>
          <p class="project-desc">{proj.description}</p>
          <div class="tags">
            {proj.tools.map((tool) => (
              <span>{tool}</span>
            ))}
          </div>
          <div class="blender-actions">
            <a
              class="hs-button secondary download-btn"
              href={proj.downloadUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="download-label">
                Download {proj.downloadFile} <span class="file-size">({proj.size})</span>
              </span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <SubpageNav
    prev={{ href: routes.creative.path, label: routes.creative.hubLabel }}
    next={{ href: routes.trips.path, label: routes.trips.title }}
  />

  <GalleryViewer />
</BaseLayout>

<style>
  .blender-grid {
    display: flex;
    flex-direction: column;
    gap: 25px;
    margin-block: 40px 70px;
  }
  .blender-card {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 36px;
    align-items: center;
    padding: 24px;
  }
  .blender-figure {
    margin: 0;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  .blender-figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .blender-figure:hover img {
    transform: scale(1.02);
  }
  .blender-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .blender-details h2 {
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: -0.8px;
    margin: 0;
  }
  .project-desc {
    margin: 0;
  }
  .blender-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 10px;
    flex-wrap: wrap;
  }
  .download-btn {
    padding: 8px 16px;
    max-width: 100%;
    text-align: left;
  }
  .download-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .file-size {
    opacity: 0.7;
    font-size: var(--fs-label);
    font-family: var(--mono);
  }
  @media (max-width: 900px) {
    .blender-card {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
