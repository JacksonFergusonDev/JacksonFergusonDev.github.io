---
import { getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import GalleryViewer from '../../components/GalleryViewer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import SubpageNav from '../../components/SubpageNav.astro';
import { routes } from '../../lib/site';

const entry = await getEntry('creative', 'events');
if (!entry || entry.data.type !== 'events') {
  throw new Error('Missing or invalid creative/events content entry');
}

const { Content } = await render(entry);
const { data } = entry;

const coverImage = data.images[0]
  ? await getImage({ src: data.images[0].src, width: 1200, format: 'jpg', quality: 85 })
  : undefined;
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={coverImage?.src}
  imageAlt={data.images[0]?.alt}
>
  <ArticleHeader
    breadcrumbHref={routes.creative.path}
    breadcrumbLabel={routes.creative.breadcrumb}
    eyebrow={data.eyebrow}
    title={data.title}
    description={data.description}
  />

  {entry.body?.trim() && (
    <div class="container">
      <div class="prose trip-body">
        <Content />
      </div>
    </div>
  )}

  <PhotoGallery photos={data.images} />

  <SubpageNav
    prev={{ href: routes.creative.path, label: routes.creative.hubLabel }}
    next={{ href: routes.trips.path, label: routes.trips.title }}
  />

  <GalleryViewer />
</BaseLayout>
