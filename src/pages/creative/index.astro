---
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SubpageNav from '../../components/SubpageNav.astro';
import ThumbnailCard from '../../components/ThumbnailCard.astro';
import { getImage } from 'astro:assets';
import { routes } from '../../lib/site';

const entry = await getEntry('creative', 'index');
if (!entry || entry.data.type !== 'index') {
  throw new Error('Missing or invalid creative/index content entry');
}

const [eventsEntry, blenderEntry, pythonEntry] = await Promise.all([
  getEntry('creative', 'events'),
  getEntry('creative', 'blender'),
  getEntry('creative', 'python'),
]);

const dynamicCovers: Record<string, { image: ImageMetadata; alt: string; count?: number }> = {};

if (eventsEntry?.data.type === 'events' && eventsEntry.data.images[0]) {
  dynamicCovers.events = {
    image: eventsEntry.data.images[0].src,
    alt: eventsEntry.data.images[0].alt,
    count: eventsEntry.data.images.length,
  };
}

if (blenderEntry?.data.type === 'blender' && blenderEntry.data.projects[0]) {
  dynamicCovers.blender = {
    image: blenderEntry.data.projects[0].image,
    alt: blenderEntry.data.projects[0].alt,
    count: blenderEntry.data.projects.length,
  };
}

if (pythonEntry?.data.type === 'python' && pythonEntry.data.pieces[0]) {
  dynamicCovers.python = {
    image: pythonEntry.data.pieces[0].image,
    alt: pythonEntry.data.pieces[0].alt,
    count: pythonEntry.data.pieces.length,
  };
}

const { data } = entry;

const subEntries: Record<string, { title: string; description: string } | undefined> = {
  events: eventsEntry?.data.type === 'events' ? eventsEntry.data : undefined,
  blender: blenderEntry?.data.type === 'blender' ? blenderEntry.data : undefined,
  python: pythonEntry?.data.type === 'python' ? pythonEntry.data : undefined,
};

const defaultNouns: Record<string, { singular: string; plural: string }> = {
  events: { singular: 'PHOTO', plural: 'PHOTOS' },
  blender: { singular: 'PROJECT', plural: 'PROJECTS' },
  python: { singular: 'ARTWORK', plural: 'ARTWORKS' },
};

const collections = data.collections.map((col) => {
  const route = routes.creative[col.id as 'events' | 'blender' | 'python'];
  const subEntry = subEntries[col.id];
  const dynamicCover = dynamicCovers[col.id];
  const image = dynamicCover?.image;
  const alt = dynamicCover?.alt ?? col.id;
  if (!image) {
    throw new Error(`Missing cover image for creative collection: ${col.id}`);
  }

  const count = dynamicCover?.count ?? 0;
  const nounObj = defaultNouns[col.id];
  const noun =
    col.noun ?? (count === 1 ? (nounObj?.singular ?? 'ITEM') : (nounObj?.plural ?? 'ITEMS'));
  const eyebrow = `${count} ${noun} · ${col.tag}`;

  if (!subEntry) {
    throw new Error(`Missing subpage content entry for creative collection: ${col.id}`);
  }

  return {
    ...col,
    title: subEntry.title,
    description: subEntry.description,
    href: route.path,
    image,
    alt,
    eyebrow,
  };
});

const featuredCover = collections.find((c) => c.id === 'blender') ?? collections[0];
const ogImage = featuredCover
  ? await getImage({ src: featuredCover.image, width: 1200, format: 'jpg', quality: 85 })
  : undefined;
---

<BaseLayout
  title={routes.creative.pageTitle}
  description={routes.creative.description}
  image={ogImage?.src}
  imageAlt={featuredCover?.alt ?? 'Featured creative collection'}
>
  <PageIntro
    eyebrow={data.intro.eyebrow}
    titleLine1={data.intro.titleLine1}
    titleLine2={data.intro.titleLine2}
    description={data.intro.description}
  />

  <section class="thumb-grid thumb-grid-3 index-grid container" aria-label="Creative collections">
    {collections.map((col) => (
      <ThumbnailCard
        href={col.href}
        image={col.image}
        alt={col.alt}
        badge={col.eyebrow}
        title={col.title}
        description={col.description}
        widths={[480, 800, 1200]}
        sizes="(max-width: 768px) 100vw, 33vw"
        width={800}
        headingLevel="h2"
      />
    ))}
  </section>

  <SubpageNav prev={{ href: routes.trips.path, label: routes.trips.exploreLabel }} />
</BaseLayout>
