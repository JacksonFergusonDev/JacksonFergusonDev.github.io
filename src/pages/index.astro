        </div>
      </div>
    </section>
  </div>
  <GalleryViewer />
</BaseLayout>

<script>
  import { initCopyCommands } from 'house-style/js/copy-command.js';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const page = document.body;
  const fadeTargets = [...document.querySelectorAll<HTMLElement>('.landing-fade')];
  const revealTargets = [...document.querySelectorAll<HTMLElement>('.landing-reveal')];

  const showScrollReveals = () => {
    if (!('IntersectionObserver' in window)) {
      revealTargets.forEach((target) => target.classList.add('is-visible'));
      return;
    }

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        });
      },
      {
        rootMargin: '0px 0px -10% 0px',
        threshold: 0,
      },
    );

    revealTargets.forEach((target) => {
      target.style.setProperty('--landing-reveal-delay', '0ms');
      revealObserver.observe(target);
    });
  };

  if (!reducedMotion) {
    page.classList.add('landing-motion');
    showScrollReveals();

    fadeTargets.forEach((target, index) => {
      target.style.setProperty('--landing-fade-delay', `${Math.min(index * 90, 450)}ms`);
    });

    const typingTargets = [...document.querySelectorAll<HTMLElement>('[data-typewriter]')];
    const typeDelays = {
      description: 20,
      name: 31,
    };
    const pauseBetweenTargets = 80;
    const type = async () => {
      for (const target of typingTargets) {
        const text = target.dataset.typewriter ?? '';
        const speed = target.dataset.typewriterSpeed === 'description' ? 'description' : 'name';
        target.textContent = '';
        target.classList.add('typewriter-active');
        const caret = document.createElement('span');
        caret.className = 'typing-caret';
        caret.setAttribute('aria-hidden', 'true');
        target.append(caret);
        for (const character of text) {
          if (character === '.' && target.hasAttribute('data-accent-punctuation')) {
            const punctuation = document.createElement('span');
            punctuation.className = 'accent';
            punctuation.textContent = character;
            caret.before(punctuation);
          } else {
            caret.before(document.createTextNode(character));
          }
          await new Promise((resolve) => window.setTimeout(resolve, typeDelays[speed]));
        }

        caret.remove();
        await new Promise((resolve) => window.setTimeout(resolve, pauseBetweenTargets));
      }

      document.body.classList.add('landing-intro-complete');
    };

    type();
  } else {
    revealTargets.forEach((target) => target.classList.add('is-visible'));
    page.classList.add('landing-intro-complete');
  }

  initCopyCommands();
</script>
