---
import { Image, getImage } from 'astro:assets';
import skiPhoto from '../assets/skiing/1.jpg';
import headshot from '../assets/profile/jackson-ferguson.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import DataField from '../components/DataField.astro';
import AsciinemaDemo from '../components/AsciinemaDemo.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import SectionMarker from '../components/SectionMarker.astro';
import ThumbnailCard from '../components/ThumbnailCard.astro';
import SecondaryProjectCard from '../components/SecondaryProjectCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import GalleryViewer from '../components/GalleryViewer.astro';
import { site, routes } from '../lib/site';
import { homepageGraph } from '../lib/structured-data';
import {
  protostar,
  systemsAudioLab,
  dataSciencePortfolio,
  cicdRelease,
  starGround,
  tools,
} from '../lib/projects';
import { getCreativeCollections, getTrips } from '../lib/content';

const trips = await getTrips();
const creativeCollections = await getCreativeCollections();

const skiPhotoEnlarged = await getImage({
  src: skiPhoto,
  width: Math.min(2400, skiPhoto.width),
  format: 'webp',
  quality: 85,
});
---

<BaseLayout
  image="/images/og-card.png"
  imageAlt="Jackson Ferguson — I build reliable systems across software, infrastructure, and hardware."
  structuredData={homepageGraph(Astro.site!)}
>
  <section class="hero" aria-labelledby="hero-heading">
    <DataField />
    <div class="hero-inner container">
      <h1
        id="hero-heading"
        aria-label="Jackson Ferguson. I build reliable systems across software, infrastructure, and hardware."
      >
        <span data-text-reveal="heading">Jackson</span>
        <br />
        <span>
          <span data-text-reveal="heading">
            Ferguson<span class="accent">.</span>
          </span>
        </span>
      </h1>
      <p class="hero-description">
        <span class="visually-hidden">
          I build reliable systems across software, infrastructure, and hardware.
        </span>
        <span aria-hidden="true" data-text-reveal="lines">
          <span>I build reliable systems across</span> <br class="desktop-break" />
          <span>software, infrastructure, and hardware.</span>
        </span>
      </p>
      <div class="hero-actions landing-fade">
        <a class="hs-button hs-button--primary" href="#projects">
          Explore my work <Icon name="down" size={17} />
        </a>
        <a class="text-link" href="#about">
          A little about me <Icon name="down" size={16} />
        </a>
      </div>
      <div class="hero-bottom landing-fade">
        <span>BASED IN VANCOUVER, BC</span>
        <a href="#about">
          SCROLL TO EXPLORE{' '}
          <span>
            <Icon name="down" size={13} />
          </span>
        </a>
      </div>
    </div>
  </section>
  <div class="landing-sections">
    <section class="section about-section" id="about" aria-labelledby="about-heading">
      <div class="container landing-reveal">
        <SectionMarker title="01 / ABOUT" />
        <div class="about-grid">
          <h2 id="about-heading">
            Systems, software <br class="desktop-break" />
            <span class="muted">& physical constraints.</span>
          </h2>
          <div class="about-copy">
            <p class="lead">
              A Physics & Astronomy graduate with a habit of looking beneath the abstraction.
            </p>
            <p>
              I’m interested in what makes a system dependable: what happens when it fails, how it
              recovers, and how its software meets the physical world. That interest runs from
              Python tooling and release infrastructure to analog circuits and embedded data
              acquisition.
            </p>
            <p>
              I graduated from the University of Victoria in spring 2026. My next areas of
              exploration are DevOps, robotics, and physical AI.
            </p>
            <div class="resume-grid">
              <div class="resume-card">
                <h3 class="resume-card-title">Software Development</h3>
                <p class="resume-card-desc">
                  Python, developer tooling, DevOps, CI/CD, automation, and software infrastructure.
                </p>
                <a
                  class="resume-card-link"
                  href="/resumes/Jackson-Ferguson-Software-Resume.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Download Software Development resume (PDF)"
                >
                  Download PDF <Icon size={16} />
                </a>
              </div>
              <div class="resume-card">
                <h3 class="resume-card-title">Hardware–Software Systems</h3>
                <p class="resume-card-desc">
                  Software development for physical systems, including automation, embedded
                  interfaces, test systems, data acquisition, and hardware integration.
                </p>
                <a
                  class="resume-card-link"
                  href="/resumes/Jackson-Ferguson-Hardware-Software-Resume.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Download Hardware–Software Systems resume (PDF)"
                >
                  Download PDF <Icon size={16} />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="projects" aria-labelledby="projects-heading">
      <div class="container">
        <header class="projects-head landing-reveal">
          <SectionMarker title="02 / PROJECTS" />
          <div class="section-heading">
            <h2 id="projects-heading">
              Selected work <br class="desktop-break" />
              <span class="muted">and technical systems.</span>
            </h2>
            <a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">
              All repositories <Icon size={16} />
            </a>
          </div>
        </header>
        <article class="project-card flagship landing-reveal">
          <div class="flagship-grid">
            <div class="flagship-copy">
              <p class="eyebrow">{protostar.eyebrow}</p>
              <h3 class="flagship-title">
                <a
                  class="protostar-title-link"
                  href={protostar.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Protostar documentation"
                >
                  <img src="/images/protostar.svg" alt="" width="30" height="30" />
                  Protostar
                </a>
              </h3>
              <p class="project-subtitle">{protostar.subtitle}</p>
              <p>{protostar.description}</p>
              <div class="metrics">
                {protostar.scores.map((score) => (
                  <div>
                    <strong>{score.value}</strong>
                    <span>
                      <a
                        class="text-link"
                        href={score.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {score.label} <Icon size={16} />
                      </a>
                    </span>
                  </div>
                ))}
              </div>
              <div class="hs-install-header">
                <span class="hs-install-label">Install globally</span>
                <div class="hs-install-toggle" role="tablist" aria-label="Installation method">
                  <button
                    type="button"
                    role="tab"
                    aria-selected="true"
                    aria-controls="protostar-install"
                    class="hs-install-tab is-active"
                    data-command="uv tool install protostar"
                  >
                    uv
                  </button>
                  <button
                    type="button"
                    role="tab"
                    aria-selected="false"
                    aria-controls="protostar-install"
                    class="hs-install-tab"
                    data-command="brew install jacksonfergusondev/tap/protostar"
                  >
                    brew
                  </button>
                </div>
              </div>
              <div class="hs-install" id="protostar-install" aria-label="Install command">
                <code>uv tool install protostar</code>
                <button
                  type="button"
                  class="hs-install-copy"
                  data-copy="uv tool install protostar"
                  aria-label="Copy install command"
                >
                  Copy<span class="hs-install-copy-long"> command</span>
                </button>
              </div>
              <div class="tags">
                {protostar.tags?.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
            <AsciinemaDemo />
          </div>
          <div class="feature-principles">
            <div>
              <h4>The preview is the plan.</h4>
              <p>
                A preview shows exactly what a run will do, because both come from the same plan.
              </p>
            </div>
            <div>
              <h4>No half-finished setups.</h4>
              <p>A failed step or Ctrl+C restores every tracked file, byte for byte.</p>
            </div>
            <div>
              <h4>Your edits survive.</h4>
              <p>
                Configuration merges setting by setting, so your keys, comments, and formatting stay
                where they are.
              </p>
            </div>
          </div>
          <div class="card-footer">
            <div class="project-actions">
              <a
                class="hs-button hs-button--primary"
                href={protostar.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Documentation <Icon size={16} />
              </a>
              <a class="text-link" href={protostar.repo} target="_blank" rel="noopener noreferrer">
                View on GitHub <Icon size={16} />
              </a>
            </div>
          </div>
        </article>
        <article class="project-card audio-card landing-reveal">
          <div class="audio-copy">
            <p class="eyebrow">{systemsAudioLab.eyebrow}</p>
            <h3>
              <a href={systemsAudioLab.repo} target="_blank" rel="noopener noreferrer">
                {systemsAudioLab.name}
              </a>
            </h3>
            <p class="project-subtitle">{systemsAudioLab.subtitle}</p>
            <p>{systemsAudioLab.description}</p>
            <div class="metrics">
              {systemsAudioLab.metrics.map((metric) => (
                <div>
                  <strong>
                    {metric.value} <small set:html={metric.unit} />
                  </strong>
                  <span set:html={metric.label} />
                </div>
              ))}
            </div>
            <div class="tags">
              {systemsAudioLab.tags?.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
            <div class="project-actions">
              <a
                class="hs-button hs-button--primary"
                href={systemsAudioLab.report.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {systemsAudioLab.report.label} <Icon size={16} />
              </a>
              <a
                class="text-link"
                href={systemsAudioLab.repo}
                target="_blank"
                rel="noopener noreferrer"
              >
                View on GitHub <Icon size={16} />
              </a>
            </div>
          </div>
          <div class="signal-art">
            <span class="signal-label">MEASURED SIGNAL / TIME + FREQUENCY DOMAIN</span>
            <a
              href={systemsAudioLab.repo}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Systems Audio Lab on GitHub"
            >
              <img
                src="/images/audio-analysis.svg"
                alt="Measured time-domain soft clipping and frequency-domain harmonic analysis"
                width="1145"
                height="495"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
              />
            </a>
            <span class="signal-note">Prototype measurements from the full signal chain</span>
          </div>
        </article>
        <article class="project-card data-science-card landing-reveal">
          <div class="data-science-copy">
            <p class="eyebrow">{dataSciencePortfolio.eyebrow}</p>
            <h3>
              <a href={dataSciencePortfolio.repo} target="_blank" rel="noopener noreferrer">
                {dataSciencePortfolio.name}
              </a>
            </h3>
            <p class="project-subtitle">{dataSciencePortfolio.subtitle}</p>
            <p>{dataSciencePortfolio.description}</p>
            <div class="metrics">
              {dataSciencePortfolio.metrics.map((metric) => (
                <div>
                  <strong>
                    {metric.value} <small set:html={metric.unit} />
                  </strong>
                  <span set:html={metric.label} />
                </div>
              ))}
            </div>
            <div class="tags">
              {dataSciencePortfolio.tags?.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
            <div class="project-actions">
              <a
                class="hs-button hs-button--primary"
                href={dataSciencePortfolio.report.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {dataSciencePortfolio.report.label} <Icon size={16} />
              </a>
              <a
                class="text-link"
                href={dataSciencePortfolio.repo}
                target="_blank"
                rel="noopener noreferrer"
              >
                View on GitHub <Icon size={16} />
              </a>
            </div>
          </div>
          <div class="signal-art">
            <span class="signal-label">ACO 2670 / KINEMATICS & REDSHIFT DISTRIBUTION</span>
            <a
              href={dataSciencePortfolio.repo}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Data Science Portfolio on GitHub"
            >
              <img
                src="/images/gmm-redshift-distribution.svg"
                alt="Redshift distribution and Gaussian mixture model selection for galaxy cluster ACO 2670"
                width="608"
                height="391"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
              />
            </a>
            <span class="signal-note">
              Gaussian Mixture Model selection and virialization analysis for ACO 2670
            </span>
          </div>
        </article>
        <div class="project-pair landing-reveal">
          <SecondaryProjectCard
            eyebrow={cicdRelease.eyebrow}
            titleLines={cicdRelease.titleLines}
            subtitle={cicdRelease.subtitle}
            repoUrl={cicdRelease.repo}
            description={cicdRelease.description}
            tags={cicdRelease.tags}
          />
          <SecondaryProjectCard
            eyebrow={starGround.eyebrow}
            title={starGround.name}
            subtitle={starGround.subtitle}
            repoUrl={starGround.repo}
            description={starGround.description}
            tags={starGround.tags}
          />
        </div>
        <div class="other-projects landing-reveal">
          {tools.map((tool) => (
            <ProjectRow
              name={tool.name}
              repoUrl={tool.url}
              description={tool.description}
              kind={tool.kind}
            />
          ))}
        </div>
      </div>
    </section>
    <section class="section beyond-section" id="beyond" aria-labelledby="beyond-heading">
      <div class="container">
        <header class="landing-reveal">
          <SectionMarker title="03 / BEYOND" />
          <div class="section-heading">
            <h2 id="beyond-heading">
              Field work <br class="desktop-break" />
              <span class="muted">& creative systems</span>
            </h2>
          </div>
        </header>

        <article class="project-card beyond-card landing-reveal">
          <p class="eyebrow">CREATIVE STUDIO & MEDIA</p>
          <h3>Sound, 3D simulation & generative code</h3>
          <p class="beyond-card-intro">
            Outside of code, I work with sound, light, and simulation: running live events, building
            scenes in Blender, and generating art with Python.
          </p>
          <div class="thumb-grid thumb-grid-3">
            {creativeCollections.map((col) => (
              <ThumbnailCard
                href={col.href}
                image={col.image}
                alt={col.alt}
                badge={col.badge}
                title={col.title}
                description={col.description}
                widths={[400, 700]}
                sizes="(max-width: 768px) 100vw, 33vw"
                width={600}
              />
            ))}
          </div>
          <div class="project-actions">
            <a class="text-link" href={routes.creative.path}>
              Creative Hub <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </article>

        <article class="project-card beyond-card landing-reveal">
          <p class="eyebrow">CAMPING & EXPEDITIONS</p>
          <h3>Photo journals from the coast & alpine</h3>
          <p class="beyond-card-intro">
            Trips along the BC coast, through the Sea to Sky, and into the Rockies, documented as
            photo journals.
          </p>
          <div class="thumb-grid">
            {trips.slice(0, 2).map((trip) => (
              <ThumbnailCard
                href={`/trips/${trip.id}/`}
                image={trip.data.images[0].src}
                alt={trip.data.images[0].alt}
                badge={`${trip.data.location} · ${trip.data.dateLabel ?? trip.data.date.getUTCFullYear()}`}
                title={trip.data.title}
                description={trip.data.description}
                widths={[480, 800]}
                sizes="(max-width: 768px) 100vw, 50vw"
                width={800}
              />
            ))}
          </div>
          <div class="project-actions">
            <a class="text-link" href={routes.trips.path}>
              All Camping Trips <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </article>

        <article class="project-card beyond-card beyond-split landing-reveal">
          <div class="beyond-split-copy">
            <p class="eyebrow">ORIGINS & ATHLETICS</p>
            <h3 id="skiing-heading">Years on the slopes</h3>
            <p>
              Competitive alpine ski racing was my main sport growing up, with winters spent
              training across the Coast Mountains. It built a lasting respect for preparation,
              physical discipline, and fast decisions on variable terrain.
            </p>
          </div>
          <div class="signal-art">
            <figure>
              <a
                class="gallery-image-link"
                href={skiPhotoEnlarged.src}
                data-gallery-image
                aria-label="Enlarge ski racing photo"
              >
                <Image
                  src={skiPhoto}
                  alt="Alpine ski racing on course"
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 800px) 100vw, 50vw"
                  width={800}
                  format="webp"
                />
              </a>
            </figure>
          </div>
        </article>
      </div>
    </section>
    <section class="contact-section" id="contact">
      <div class="container">
        <div class="contact-head landing-reveal">
          <SectionMarker title="04 / CONTACT" />
          <h2>
            Let’s build something <br class="desktop-break" />
            that <span class="accent">holds up.</span>
          </h2>
          <Image
            class="contact-portrait"
            src={headshot}
            alt="Portrait of Jackson Ferguson"
            width={220}
            height={220}
            densities={[1, 2]}
          />
        </div>
        <div class="contact-bottom landing-reveal">
          <p>
            Have a hard problem, an interesting system, <br class="desktop-break" />
            or a reason to say hello?
          </p>
          <a class="contact-email" href={site.email}>
            {site.emailAddress} <ServiceIcon name="email" size={21} />
          </a>
        </div>
      </div>
    </section>
  </div>
  <GalleryViewer />
</BaseLayout>

<script>
  import { initCopyCommands } from 'house-style/js/copy-command.js';
  import { revealText, TEXT_REVEAL_LEAD_IN_MS } from '../scripts/reveal-text';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const page = document.body;
  const fadeTargets = [...document.querySelectorAll<HTMLElement>('.landing-fade')];
  const revealTargets = [...document.querySelectorAll<HTMLElement>('.landing-reveal')];

  const showScrollReveals = () => {
    if (!('IntersectionObserver' in window)) {
      revealTargets.forEach((target) => target.classList.add('is-visible'));
      return;
    }

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        });
      },
      {
        rootMargin: '0px 0px -10% 0px',
        threshold: 0,
      },
    );

    revealTargets.forEach((target) => {
      target.style.setProperty('--landing-reveal-delay', '0ms');
      revealObserver.observe(target);
    });
  };

  if (!reducedMotion) {
    page.classList.add('landing-motion');
    showScrollReveals();

    fadeTargets.forEach((target, index) => {
      target.style.setProperty('--landing-fade-delay', `${Math.min(index * 90, 450)}ms`);
    });

    const showIntroElements = () => page.classList.add('landing-intro-complete');
    // Overlap the fade with the sweep's easing tail, once the text is readable.
    const introFadeTimer = window.setTimeout(showIntroElements, TEXT_REVEAL_LEAD_IN_MS + 600);
    revealText([...document.querySelectorAll<HTMLElement>('[data-text-reveal]')]).then(() => {
      window.clearTimeout(introFadeTimer);
      showIntroElements();
    });
  } else {
    revealTargets.forEach((target) => target.classList.add('is-visible'));
    page.classList.add('landing-intro-complete', 'landing-text-ready');
  }

  initCopyCommands();
</script>
