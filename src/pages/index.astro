---
import { Image, getImage } from 'astro:assets';
import skiPhoto from '../assets/skiing/1.jpg';
import headshot from '../assets/profile/jackson-ferguson.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import DataField from '../components/DataField.astro';
import AsciinemaDemo from '../components/AsciinemaDemo.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import SectionMarker from '../components/SectionMarker.astro';
import ThumbnailCard from '../components/ThumbnailCard.astro';
import SecondaryProjectCard from '../components/SecondaryProjectCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import GalleryViewer from '../components/GalleryViewer.astro';
import { site, routes } from '../lib/site';
import { homepageGraph } from '../lib/structured-data';
import {
  protostar,
  systemsAudioLab,
  dataSciencePortfolio,
  cicdRelease,
  starGround,
  tools,
} from '../lib/projects';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';

type TripEntry = CollectionEntry<'trips'> & {
  data: Extract<CollectionEntry<'trips'>['data'], { type: 'trip' }>;
};

const trips = (
  (await getCollection('trips', ({ data }) => data.type === 'trip' && !data.draft)) as TripEntry[]
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const creativeEntry = await getEntry('creative', 'index');
const [eventsEntry, blenderEntry, pythonEntry] = await Promise.all([
  getEntry('creative', 'events'),
  getEntry('creative', 'blender'),
  getEntry('creative', 'python'),
]);

const dynamicCovers: Record<string, { image: ImageMetadata; alt: string; count?: number }> = {};
if (eventsEntry?.data.type === 'events' && eventsEntry.data.images[0]) {
  dynamicCovers.events = {
    image: eventsEntry.data.images[0].src,
    alt: eventsEntry.data.images[0].alt,
    count: eventsEntry.data.images.length,
  };
}
if (blenderEntry?.data.type === 'blender' && blenderEntry.data.projects[0]) {
  dynamicCovers.blender = {
    image: blenderEntry.data.projects[0].image,
    alt: blenderEntry.data.projects[0].alt,
    count: blenderEntry.data.projects.length,
  };
}
if (pythonEntry?.data.type === 'python' && pythonEntry.data.pieces[0]) {
  dynamicCovers.python = {
    image: pythonEntry.data.pieces[0].image,
    alt: pythonEntry.data.pieces[0].alt,
    count: pythonEntry.data.pieces.length,
  };
}

const subEntries: Record<string, { title: string; description: string } | undefined> = {
  events: eventsEntry?.data.type === 'events' ? eventsEntry.data : undefined,
  blender: blenderEntry?.data.type === 'blender' ? blenderEntry.data : undefined,
  python: pythonEntry?.data.type === 'python' ? pythonEntry.data : undefined,
};

const defaultNouns: Record<string, { singular: string; plural: string }> = {
  events: { singular: 'PHOTO', plural: 'PHOTOS' },
  blender: { singular: 'PROJECT', plural: 'PROJECTS' },
  python: { singular: 'ARTWORK', plural: 'ARTWORKS' },
};

const creativeCollections = (
  creativeEntry?.data.type === 'index' ? creativeEntry.data.collections : []
).map((col) => {
  const route = routes.creative[col.id as 'events' | 'blender' | 'python'];
  const subEntry = subEntries[col.id];
  const dynamicCover = dynamicCovers[col.id];
  const image = dynamicCover?.image;
  const alt = dynamicCover?.alt ?? col.id;
  const count = dynamicCover?.count ?? 0;
  const nounObj = defaultNouns[col.id];
  const noun =
    col.noun ?? (count === 1 ? (nounObj?.singular ?? 'ITEM') : (nounObj?.plural ?? 'ITEMS'));
  const eyebrow = `${count} ${noun} · ${col.tag}`;

  return {
    ...col,
    title: subEntry?.title ?? col.id,
    description: subEntry?.description ?? '',
    href: route.path,
    image,
    alt,
    eyebrow,
  };
});

const skiPhotoEnlarged = await getImage({
  src: skiPhoto,
  width: Math.min(2400, skiPhoto.width),
  format: 'webp',
  quality: 85,
});
---

<BaseLayout
  image="/images/og-card.png"
  imageAlt="Jackson Ferguson — I build reliable systems across software, infrastructure, and hardware."
  structuredData={homepageGraph(Astro.site!)}
>
  <section class="hero" aria-labelledby="hero-heading">
    <DataField />
    <div class="hero-inner container">
      <h1
        id="hero-heading"
        aria-label="Jackson Ferguson. I build reliable systems across software, infrastructure, and hardware."
      >
        <span data-typewriter="Jackson" data-typewriter-speed="name">
          Jackson
        </span>
        <br />
        <span>
          <span data-typewriter="Ferguson." data-typewriter-speed="name" data-accent-punctuation>
            Ferguson.
          </span>
        </span>
      </h1>
      <p class="hero-description">
        <span class="visually-hidden">
          I build reliable systems across software, infrastructure, and hardware.
        </span>
        <span aria-hidden="true">
          <span
            data-typewriter="I build reliable systems across"
            data-typewriter-speed="description"
          >
            I build reliable systems across
          </span>{' '}
          <br class="desktop-break" />
          <span
            data-typewriter="software, infrastructure, and hardware."
            data-typewriter-speed="description"
          >
            software, infrastructure, and hardware.
          </span>
        </span>
      </p>
      <div class="hero-actions landing-fade">
        <a class="hs-button hs-button--primary" href="#projects">
          Explore my work <Icon name="down" size={17} />
        </a>
        <a class="text-link" href="#about">
          A little about me <Icon name="down" size={16} />
        </a>
      </div>
      <div class="hero-bottom landing-fade">
        <span>BASED IN VANCOUVER, BC</span>
        <a href="#about">
          SCROLL TO EXPLORE{' '}
          <span>
            <Icon name="down" size={13} />
          </span>
        </a>
      </div>
    </div>
  </section>
  <div class="landing-sections">
    <section class="section about-section" id="about" aria-labelledby="about-heading">
      <div class="container landing-reveal">
        <SectionMarker title="01 / ABOUT" />
        <div class="about-grid">
          <h2 id="about-heading">
            Systems, software <br class="desktop-break" />
            <span class="muted">& physical constraints.</span>
          </h2>
          <div class="about-copy">
            <p class="lead">
              A Physics & Astronomy graduate with a habit of looking beneath the abstraction.
            </p>
            <p>
              I’m interested in what makes a system dependable: how it represents state, how it
