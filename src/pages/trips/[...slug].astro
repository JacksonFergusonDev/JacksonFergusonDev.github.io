---
import GalleryViewer from '../../components/GalleryViewer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import SubpageNav from '../../components/SubpageNav.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { routes } from '../../lib/site';

type TripEntry = CollectionEntry<'trips'> & {
  data: Extract<CollectionEntry<'trips'>['data'], { type: 'trip' }>;
};

export async function getStaticPaths() {
  const trips = (await getCollection(
    'trips',
    ({ data }) => data.type === 'trip' && !data.draft,
  )) as TripEntry[];
  return trips.map((trip) => ({
    params: { slug: trip.id },
    props: { trip },
  }));
}

interface Props {
  trip: TripEntry;
}

const { trip } = Astro.props;
const { Content } = await render(trip);

const ogImage = await getImage({
  src: trip.data.images[0].src,
  width: 1200,
  format: 'jpg',
  quality: 85,
});
---

<BaseLayout
  title={trip.data.title}
  description={trip.data.description}
  image={ogImage.src}
  imageAlt={trip.data.images[0].alt}
>
  <ArticleHeader
    breadcrumbHref={routes.trips.path}
    breadcrumbLabel={routes.trips.breadcrumb}
    eyebrow={`${trip.data.location} / ${trip.data.dateLabel ?? trip.data.date.getUTCFullYear()}`}
    title={trip.data.title}
    description={trip.data.description}
  />
  <div class="container">
    <div class="prose trip-body">
      <Content />
    </div>
  </div>
  <PhotoGallery photos={trip.data.images} />
  <SubpageNav
    prev={{ href: routes.trips.path, label: `Back to all ${routes.trips.navLabel.toLowerCase()}` }}
    next={{ href: routes.creative.path, label: routes.creative.title }}
  />
  <GalleryViewer />
</BaseLayout>
