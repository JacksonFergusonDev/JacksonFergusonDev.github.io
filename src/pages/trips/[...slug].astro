---
import GalleryViewer from '../../components/GalleryViewer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import SubpageNav from '../../components/SubpageNav.astro';
import { render } from 'astro:content';
import { routes } from '../../lib/site';
import { getTrips, type TripEntry } from '../../lib/content';
import { getEnlargedImage } from '../../lib/images';
import { galleryGraph } from '../../lib/structured-data';

export async function getStaticPaths() {
  const trips = await getTrips();
  return trips.map((trip) => ({
    params: { slug: trip.id },
    props: { trip },
  }));
}

interface Props {
  trip: TripEntry;
}

const { trip } = Astro.props;
const { Content } = await render(trip);

const enlarged = await Promise.all(trip.data.images.map((image) => getEnlargedImage(image.src)));
const structuredData = galleryGraph(Astro.site!, {
  path: Astro.url.pathname,
  name: trip.data.title,
  description: trip.data.description,
  crumbs: [
    { name: routes.trips.navLabel, path: routes.trips.path },
    { name: trip.data.title, path: Astro.url.pathname },
  ],
  location: trip.data.location,
  images: trip.data.images.map((image, i) => ({
    url: enlarged[i].src,
    caption: image.caption ?? image.alt,
  })),
});
---

<BaseLayout
  title={trip.data.seoTitle ?? trip.data.title}
  description={trip.data.description}
  image={`/images/og/trips-${trip.id}.png`}
  imageAlt={`${trip.data.title}: ${trip.data.description}`}
  structuredData={structuredData}
>
  <ArticleHeader
    breadcrumbHref={routes.trips.path}
    breadcrumbLabel={routes.trips.breadcrumb}
    eyebrow={`${trip.data.location} / ${trip.data.dateLabel ?? trip.data.date.getUTCFullYear()}`}
    title={trip.data.title}
    description={trip.data.description}
  />
  <div class="container">
    <div class="prose trip-body">
      <Content />
    </div>
  </div>
  <PhotoGallery photos={trip.data.images} />
  <SubpageNav
    prev={{ href: routes.trips.path, label: `Back to all ${routes.trips.navLabel.toLowerCase()}` }}
    next={{ href: routes.creative.path, label: routes.creative.title }}
  />
  <GalleryViewer />
</BaseLayout>
